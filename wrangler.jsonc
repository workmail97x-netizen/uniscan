{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uniscan",
  "main": "worker-v32.js",
  "compatibility_date": "2026-08-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "UniScanSession"
      }
    ]
  },
  "exports": {
    "UniScanSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}